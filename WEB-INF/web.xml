    <servlet-class>com.SmartTutor.servlet.ListTutorsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ListTutorsServlet</servlet-name>
    <url-pattern>/Tutorslist</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AddSubjectServlet.java</servlet-name>
    <servlet-class>com.SmartTutor.servlet.AddSubjectServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AddSubjectServlet.java</servlet-name>
    <url-pattern>/AddSubjectServlet</url-pattern>
  </servlet-mapping>

